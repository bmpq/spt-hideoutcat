<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>hideoutcat.bepinex</AssemblyName>
    <Version>1.0.1</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Configurations>RUNTIME</Configurations>
  </PropertyGroup>

  <PropertyGroup>
    <SPTPath>E:\Games\SPT_3.11</SPTPath>
    <RootNamespace>tarkin.$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\hideoutcat\hideoutcat.csproj" />
    
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.43" IncludeAssets="compile" />
  </ItemGroup>
  
  <ItemGroup>
    <Reference Include="$(SPTPath)\BepInEx\core\BepInEx.dll" />
    <Reference Include="$(SPTPath)\BepInEx\core\0Harmony.dll" />
    <Reference Include="$(SPTPath)\BepInEx\plugins\spt\spt-reflection.dll" />
    
    <Reference Include="$(SPTPath)\BepInEx\plugins\tarkin\IMGUIDebugDraw.dll" />
    
    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll" />
    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\Assembly-CSharp-firstpass.dll" />
    
    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\Cinemachine.dll" />
    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\Comfort.dll" />
    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\Sirenix.Serialization.dll" />

    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\UnityEngine.UI.dll" />
    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\UnityEngine.UIModule.dll" />
    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\Unity.TextMeshPro.dll" />
  </ItemGroup>

  <Target Name="CopyDllAfterBuild" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(SPTPath)\BepInEx\plugins\tarkin" />
  </Target>
</Project>
