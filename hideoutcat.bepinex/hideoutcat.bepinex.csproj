<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>hideoutcat.bepinex</AssemblyName>
    <Product>hideoutcat</Product>
    <Version>1.0.1</Version>
    <LangVersion>latest</LangVersion>
    <RootNamespace>tarkin.$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\hideoutcat\hideoutcat.csproj" />
    <ProjectReference Include="..\hideoutcat.ui\hideoutcat.ui.csproj" />
    <ProjectReference Include="..\hideoutcat.scene\hideoutcat.scene.csproj" />
    
    <PackageReference Include="BepInEx.Analyzers" Version="1.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Unity.Analyzers" Version="1.23.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" />
  </ItemGroup>
  
  <ItemGroup>
    <Reference Include="$(SPTPath)\BepInEx\core\BepInEx.dll" />
    <Reference Include="$(SPTPath)\BepInEx\core\0Harmony.dll" />
    <Reference Include="$(SPTPath)\BepInEx\plugins\spt\spt-reflection.dll" />
    
    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\*.dll" />
  </ItemGroup>

  <Target Name="CopyDllAfterBuild" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(SPTPath)\BepInEx\plugins\tarkin" />
  </Target>
  
</Project>
